# CrowdWise Delhi Environment Configuration
# Copy to .env and populate secrets via your environment or AI Studio Secrets panel.
# Never commit real keys or secrets to version control.

# Frontend API configuration ("demo" uses local/Node demo endpoints; "api" connects to external FastAPI backend)
VITE_DATA_MODE="demo"
VITE_API_BASE_URL="/api"

# Google Maps Platform API Key (restrict to HTTP referrers and Maps JS API)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Server / Platform Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000
